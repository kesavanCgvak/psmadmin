APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Optional: minimum level for storage/logs/flex-integration.log (defaults to LOG_LEVEL)
# FLEX_LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Flex Sales Quote: element definition UUID (from Flex). Used for POST /f5/api/element/ and GET …/element/{id}/fields
FLEX_SALES_QUOTE_DEFINITION_ID=

# Optional overrides (if unset, values are taken from GET element/{definitionId}/fields when FLEX_USE_ELEMENT_FIELDS_API=true)
# FLEX_SALES_QUOTE_STATUS_ID=
# FLEX_SALES_QUOTE_PERSON_RESPONSIBLE_ID=
# FLEX_SALES_QUOTE_LOCATION_ID=
# FLEX_SALES_QUOTE_DEFAULT_PRICING_MODEL_ID=
# FLEX_ELEMENT_FIELDS_CACHE_TTL=3600
# FLEX_USE_ELEMENT_FIELDS_API=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# TextMagic SMS API (optional - SMS notifications disabled when not set)
TEXTMAGIC_USERNAME=
TEXTMAGIC_API_KEY=

# Rentman API base URL used for integration credential validation.
RENTMAN_API_BASE_URL=https://api.rentman.net
# Rentman dimensions are always in inches and weight in lbs; map to PSM unit code/name.
RENTMAN_DEFAULT_LINEAR_UNIT=inches
RENTMAN_DEFAULT_WEIGHT_UNIT=lbs
# Optional: override with explicit PSM DB IDs (takes precedence over code/name above).
# RENTMAN_DEFAULT_LINEAR_UNIT_ID=
# RENTMAN_DEFAULT_WEIGHT_UNIT_ID=

# Inventory Master AI specification enrichment (php artisan inventory:enrich-specifications)
# Create keys at https://platform.openai.com/api-keys
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano
# OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini (optional — set AI_PROVIDER=gemini to use)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_API_VERSION=v1beta

# AI_TIMEOUT=60
# Rate limit pacing — see https://developers.openai.com/api/docs/guides/rate-limits
# Check your limits: https://platform.openai.com/settings/limits
AI_REQUESTS_PER_MINUTE=3
# AI_RATE_LIMIT_MAX_RETRIES=6
# AI_RATE_LIMIT_INITIAL_BACKOFF=1
# AI_RATE_LIMIT_MAX_BACKOFF=60
# AI_MAX_OUTPUT_TOKENS=512
# INVENTORY_AI_BATCH_SIZE=100
# INVENTORY_AI_QUEUE=default
# INVENTORY_AI_AUTO_APPROVE_THRESHOLD=60

# Swagger / Partner Open API documentation (public UI at /api/documentation)
# L5_SWAGGER_CONST_HOST=http://psmadmin.test
# L5_SWAGGER_GENERATE_ALWAYS=false
# L5_SWAGGER_UI_DOC_EXPANSION=list
