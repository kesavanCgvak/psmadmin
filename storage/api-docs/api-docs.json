        "/api/v1/partner/products/{product_id}": {
            "get": {
                "tags": [
                    "Partner Products"
                ],
                "summary": "Get product details",
                "description": "Get full details for a single product in the provider company inventory.",
                "operationId": "partnerProductDetails",
                "parameters": [
                    {
                        "name": "product_id",
                        "in": "path",
                        "description": "Product ID from search results.",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 101
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Product details fetched successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Product details fetched successfully."
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/PartnerProductDetail"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Open API access disabled, expired key, or invalid provider context.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Product not found in provider inventory.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests (rate limit: 60 requests per minute).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "partnerApiKey": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "ApiError": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "Invalid API key."
                    }
                },
                "type": "object"
            },
            "PartnerProductMinimal": {
                "properties": {
                    "product_id": {
                        "type": "integer",
                        "example": 101
                    },
                    "psm_code": {
                        "type": "string",
                        "example": "PSM-001"
                    },
                    "product_name": {
                        "type": "string",
                        "example": "Sony FX6"
                    }
                },
                "type": "object"
            },
            "PartnerProductSummary": {
                "properties": {
                    "product_id": {
                        "type": "integer",
                        "example": 101
                    },
                    "product_name": {
                        "type": "string",
                        "example": "Sony FX6"
                    },
                    "model_name": {
                        "type": "string",
                        "example": "FX6"
                    },
                    "psm_code": {
                        "type": "string",
                        "example": "PSM-001"
                    },
                    "brand_id": {
                        "type": "integer",
                        "example": 12,
                        "nullable": true
                    },
                    "brand_name": {
                        "type": "string",
                        "example": "Sony",
                        "nullable": true
                    },
                    "category_id": {
                        "type": "integer",
                        "example": 3,
                        "nullable": true
                    },
                    "category_name": {
                        "type": "string",
                        "example": "Cameras",
                        "nullable": true
                    },
                    "sub_category_id": {
                        "type": "integer",
                        "example": 8,
                        "nullable": true
                    },
                    "sub_category_name": {
                        "type": "string",
                        "example": "Cinema",
                        "nullable": true
                    },
                    "quantity": {
                        "type": "integer",
                        "example": 4
                    },
                    "rental_price": {
                        "type": "number",
                        "format": "float",
                        "example": 250,
                        "nullable": true
                    },
                    "software_code": {
                        "type": "string",
                        "example": "FX6-01",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "PartnerProductDetail": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/PartnerProductSummary"
                    },
                    {
                        "properties": {
                            "webpage_url": {
                                "type": "string",
                                "nullable": true
                            },
                            "is_verified": {
                                "type": "boolean",
                                "example": true
                            },
                            "height": {
                                "type": "number",
                                "format": "float",
                                "nullable": true
                            },
                            "width": {
                                "type": "number",
                                "format": "float",
                                "nullable": true
                            },
                            "length": {
                                "type": "number",
                                "format": "float",
                                "nullable": true
                            },
                            "weight": {
                                "type": "number",
                                "format": "float",
                                "nullable": true
                            },
                            "linear_unit_id": {
                                "type": "integer",
                                "nullable": true
                            },
                            "weight_unit_id": {
                                "type": "integer",
                                "nullable": true
                            },
                            "replacement_price": {
                                "type": "number",
                                "format": "float",
                                "nullable": true
                            },
                            "source": {
                                "type": "string",
                                "nullable": true
                            },
                            "country_of_origin": {
                                "type": "string",
                                "nullable": true
                            },
                            "iso_code_2": {
                                "type": "string",
                                "nullable": true
                            },
                            "iso_code_3": {
                                "type": "string",
                                "nullable": true
                            },
                            "hsn_code": {
                                "type": "string",
                                "nullable": true
                            }
                        },
                        "type": "object"
                    }
                ]
            },
            "PartnerChatMessageRequest": {
                "required": [
                    "external_system",
                    "external_message_id",
                    "external_conversation_id",
                    "body"
                ],
                "properties": {
                    "external_system": {
                        "description": "Stable system slug. Allowed values: rentman, flex.",
                        "type": "string",
                        "example": "rentman"
                    },
                    "external_message_id": {
                        "type": "string",
                        "example": "external-message-123",
                        "maxLength": 191
                    },
                    "external_conversation_id": {
                        "type": "string",
                        "example": "external-conversation-456",
                        "maxLength": 191
                    },
                    "psm_conversation_id": {
                        "description": "Required until this external conversation id is mapped. Must be a conversation the authenticated company belongs to.",
                        "type": "integer",
                        "example": 123,
                        "nullable": true
                    },
                    "body": {
                        "type": "string",
                        "example": "Hello, we have received your rental request.",
                        "maxLength": 2000,
                        "minLength": 1
                    },
                    "external_created_at": {
                        "description": "Stored on the external message link. Unread state uses the PSM message timestamp.",
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-10-12T10:30:00Z",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "PartnerChatMessage": {
                "properties": {
                    "id": {
                        "description": "PSM chat message id.",
                        "type": "integer",
                        "example": 55
                    },
                    "conversation_id": {
                        "type": "integer",
                        "example": 123
                    },
                    "external_system": {
                        "type": "string",
                        "example": "rentman"
                    },
                    "external_message_id": {
                        "type": "string",
                        "example": "external-message-123"
                    },
                    "external_conversation_id": {
                        "type": "string",
                        "example": "external-conversation-456"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-10-12T10:30:05+00:00"
                    }
                },
                "type": "object"
            },
            "PartnerChatConversation": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 123
                    },
                    "counterparty_company_id": {
                        "type": "integer",
                        "example": 45
                    },
                    "counterparty_company_name": {
                        "type": "string",
                        "example": "Northwind Rentals"
                    },
                    "rental_job_id": {
                        "type": "integer",
                        "example": null,
                        "nullable": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "ValidationError": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "Validation error"
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "type": "object"
            },
            "PaginationMeta": {
                "properties": {
                    "page": {
                        "type": "integer",
                        "example": 1
                    },
                    "per_page": {
                        "type": "integer",
                        "example": 25
                    },
                    "total": {
                        "type": "integer",
                        "example": 120
                    },
                    "total_pages": {
                        "type": "integer",
                        "example": 5
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "partnerApiKey": {
                "type": "http",
                "description": "Provider API key. Format: `psm_pk_...`. Chat routes require the `chat` scope. Product routes accept legacy keys and keys that include the `products` scope. Alternative header: `X-API-KEY`.",
                "bearerFormat": "API Key",
                "scheme": "bearer"
            }
        }
    },
    "security": [
        {
            "partnerApiKey": []
