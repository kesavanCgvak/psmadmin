{
    "openapi": "3.0.0",
    "info": {
        "title": "PSM Partner Open API",
        "description": "Partner APIs for provider companies.\n\n**Getting started**\n1. Log in as a provider user and generate an API key (`psm_pk_...`).\n2. Ensure the company has **Open API Access** enabled by an administrator.\n3. Send the API key on each request using `Authorization: Bearer {api_key}` (preferred) or `X-API-KEY: {api_key}`.\n\n**Scopes**\nKeys created before scopes existed, and keys generated without a `scopes` value, can call product endpoints only.\nChat endpoints require a key whose scopes include `chat`. Generate one with `POST /api/provider/api-keys/generate` and `\"scopes\": [\"chat\"]` or `\"scopes\": [\"products\", \"chat\"]`.\nGenerating a key revokes the previous active key for that user. Include every scope the new key should keep.\n\nProduct results and chat conversations are limited to the provider company linked to the API key.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://psmadmin.test",
            "description": "API server"
        }
    ],
    "paths": {
        "/api/v1/partner/chat/messages": {
            "post": {
                "tags": [
                    "Partner Chat"
                ],
                "summary": "Submit an inbound chat message",
                "description": "Creates a PSM chat message in a company-to-company conversation, or returns the existing message when the same external id is retried.\n\nThe API key identifies the sending company. That company must be a participant in the conversation. The sender user is the company's default contact, who must belong to that company and must not be blocked. The request cannot name a different sending company.\n\n`external_conversation_id` is stored as a company-scoped mapping. The first request for an external conversation must include `psm_conversation_id`. Later requests may omit it. There is no matching by company name, contact name, or email.\n\nRetries with the same `external_system` and `external_message_id` for the same conversation and body return HTTP 200 and do not create another message, broadcast, or notification. A reused external message id with a different body or conversation returns HTTP 409.\n\n`external_created_at` is stored for reference. Unread counts use the PSM `created_at` of the chat message.\n\nRate limit: 60 requests per minute for the authenticated company.",
                "operationId": "partnerChatStoreMessage",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PartnerChatMessageRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Message created. Existing chat broadcast and notification behavior runs for this new message.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Message sent."
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/PartnerChatMessage"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Idempotent retry. The original PSM message id is returned and no duplicate message is created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Existing message returned."
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/PartnerChatMessage"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key. A revoked key is treated as invalid.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Expired key, Open API disabled, non-provider account, missing chat scope, or the conversation belongs to other companies.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "PSM conversation was not found, or the external conversation has not been mapped yet.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "The external message id was already used for a different body or conversation, or the external conversation id is mapped to a different PSM conversation.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid fields, or the authenticated company has no valid default contact to use as the sender.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests (rate limit: 60 requests per minute per company).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "partnerApiKey": []
                    }
                ]
            }
        },
        "/api/v1/partner/chat/conversations": {
            "get": {
                "tags": [
                    "Partner Chat"
                ],
                "summary": "List conversations for mapping",
                "description": "Returns conversations that include the authenticated company, so an integrator can choose `psm_conversation_id` for the first message mapping.\n\nThe payload is limited to the conversation id, counterparty company id and name, rental job id, and updated time. Message history is not included. Conversations that do not include the authenticated company are omitted.\n\nRequires the chat scope. Rate limit: 60 requests per minute for the authenticated company.",
                "operationId": "partnerChatListConversations",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1,
                            "default": 1,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 25,
                            "default": 25,
                            "maximum": 100,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Conversations fetched successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Conversations fetched successfully."
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/PartnerChatConversation"
                                            }
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/PaginationMeta"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Open API disabled, expired key, invalid provider context, or missing chat scope.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid pagination parameters.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests (rate limit: 60 requests per minute per company).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "partnerApiKey": []
                    }
                ]
            }
        },
        "/api/v1/partner/products/search": {
            "get": {
                "tags": [
                    "Partner Products"
                ],
                "summary": "Search provider products",
                "description": "Search products in the authenticated provider company inventory.",
                "operationId": "partnerProductsSearch",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "description": "Search keyword (minimum 2 characters). Matches model, brand, category, and sub-category.",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "sony",
                            "minLength": 2
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number for pagination.",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1,
                            "default": 1,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Number of items per page (max 100).",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 25,
                            "default": 25,
                            "maximum": 100,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Products fetched successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Products fetched successfully."
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/PartnerProductSummary"
                                            }
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/PaginationMeta"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Open API access disabled, expired key, or invalid provider context.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error (e.g. missing or short search query).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests (rate limit: 60 requests per minute).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "partnerApiKey": []
                    }
                ]
            }
        },
